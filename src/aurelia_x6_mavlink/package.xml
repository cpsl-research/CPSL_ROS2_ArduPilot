<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aurelia_x6_mavlink</name>
  <version>0.1.0</version>
  <description>MAVROS telemetry bridge for the Aurelia X6 hexacopter (CubePilot CubeOrange+, ArduCopter V4.5.4). Exposes odometry and TF frames; no control logic.</description>
  <maintainer email="david.hunt@duke.edu">David Hunt</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <depend>mavros</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-scipy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
